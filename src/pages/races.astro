---
import Layout from "../layouts/Layout.astro";
import Search from "../components/Search.astro";
import BreedGrid from "../components/BreedGrid.astro";
import Icon from "../components/Icon.astro";
import { getBreeds } from "../lib/breeds";
import { photos } from "../lib/media";
import { coatLabels, coatTypes } from "../lib/coats";
const breeds = (await getBreeds()).sort((a, b) =>
  a.name.localeCompare(b.name, "fr"),
);
const coats = [
  ["all", "Tous les pelages"],
  ...coatTypes
    .filter((coat) => breeds.some((b) => b.coat === coat))
    .map((coat) => [coat, coatLabels[coat]]),
];
---

<Layout
  title="Les races"
  description={`Découvre ${breeds.length} races de chats, filtre leur pelage et trouve tes coups de cœur.`}
>
  <div class="catalog-search">
    <Search id="catalog-search" />
  </div>
  <div class="catalog-toolbar">
    {coats.map(([value, label]) => (
      <button
        class="chip"
        data-coat={value}
        data-coat-type={value === "all" ? undefined : value}
        aria-pressed={value === "all"}
      >
        {label}
      </button>
    ))}
    <button
      class="button secondary mobile-filter-button"
      data-filter-panel
      aria-expanded="false"
      aria-controls="mobile-filters"
    >
      Filtres
    </button>
    <label class="sort">
      <span>Trier par</span>
      <select id="sort" aria-label="Trier les races">
        <option value="az">Nom : A–Z</option>
        <option value="za">Nom : Z–A</option>
      </select>
    </label>
  </div>
  <div class="filter-panel" id="mobile-filters">
    {coats.map(([value, label]) => (
      <button
        class="chip"
        data-coat={value}
        data-coat-type={value === "all" ? undefined : value}
        aria-pressed={value === "all"}
      >
        {label}
      </button>
    ))}
  </div>
  <div id="catalog-results">
    <p class="sr-only" id="catalog-status" role="status"></p>
    <p class="results-meta">{breeds.length} races</p>
    <BreedGrid breeds={breeds} id="catalog-grid" />
    <section class="empty" id="catalog-empty" hidden>
      <Icon name="doodle" />
      <h2>Aucun museau trouvé.</h2>
      <p>
        Essaie un autre nom ou retire les filtres pour découvrir toutes les
        races.
      </p>
      <button class="button secondary" data-reset-search>
        Voir toutes les races
      </button>
    </section>
    <article class="secret-result" id="secret-result" hidden>
      <img
        src={photos["figue-cover.jpg"].src}
        alt="Figue, petit chat noir endormi"
        width="90"
        height="90"
      />
      <div>
        <h2>Psst… tu as trouvé Figue.</h2>
        <a class="text-link" href="/figue/">
          Ouvrir son carnet <Icon />
        </a>
      </div>
    </article>
  </div>
  <noscript>
    <p class="no-js-note">
      Toutes les races sont consultables. Active JavaScript pour utiliser la
      recherche et les filtres.
    </p>
  </noscript>
</Layout>
