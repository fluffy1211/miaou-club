---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Search from "../components/Search.astro";
import RandomButton from "../components/RandomButton.astro";
import Polaroid from "../components/Polaroid.astro";
import BreedGrid from "../components/BreedGrid.astro";
import { getBreeds } from "../lib/breeds";
const breeds = await getBreeds();
---

<Layout>
  <section class="hero">
    <div class="hero-copy">
      <h1>
        Des moustaches,
        <br />
        du caractère.
        <br />
        Et toi au milieu.
      </h1>
      <p>
        Un carnet pour découvrir les races de chats et collectionner tes coups
        de cœur.
      </p>
      <Search id="home-search" />
      <div class="hero-actions">
        <RandomButton />
      </div>
    </div>
    <div class="collage" aria-label="Photos de chats façon scrapbook">
      <Polaroid
        image="maine-coon.jpeg"
        caption="Enchanté, humain."
        classes="first tape"
      />
      <Polaroid
        image="siamese.jpg"
        caption="On fait connaissance ?"
        classes="second"
      />
      <span class="collage-note hand">
        Attention :<br />
        fort potentiel
        <br />
        de craquage.
      </span>
      <svg class="doodle-star" viewBox="0 0 80 80" aria-hidden="true">
        <path d="m40 2 7 27 29-6-22 19 18 25-28-12-16 23-1-29L1 41l28-9Z" />
      </svg>
    </div>
  </section>
  <section class="section">
    <div class="section-heading">
      <h2>À découvrir</h2>
      <a class="text-link" href="/races/">
        Toutes les races <Icon />
      </a>
    </div>
    <BreedGrid breeds={breeds} id="daily-discoveries" visibleCount={3} />
  </section>
  <section class="random-banner">
    <h2>Une rencontre au hasard ?</h2>
    <RandomButton label="Je tente ma chance" white />
  </section>
</Layout>
