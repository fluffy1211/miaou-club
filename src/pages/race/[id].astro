---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import BreedGrid from "../../components/BreedGrid.astro";
import FavoriteButton from "../../components/FavoriteButton.astro";
import { getBreeds, coatLabel } from "../../lib/breeds";
import { photos } from "../../lib/media";
export async function getStaticPaths() {
  return (await getBreeds()).map((b) => ({
    params: { id: b.id },
    props: { b },
  }));
}
const { b } = Astro.props;
const breeds = await getBreeds();
---

<Layout title={b.name} description={b.intro}>
  <div class="breadcrumb">
    <a href="/races/">Les races</a>
    <span aria-hidden="true">/</span>
    <span>{b.name}</span>
  </div>
  <article>
    <div class="breed-profile">
      <div class="breed-portrait tape">
        {photos[b.image] ? (
          <button
            class="photo-button"
            data-photo={photos[b.image].src}
            data-caption={`${b.name}`}
            aria-label={`Agrandir la photo du ${b.name}`}
          >
            <img
              src={photos[b.image].src}
              width={photos[b.image].width}
              height={photos[b.image].height}
              alt={`Portrait d’un ${b.name}`}
              style={`object-position:${b.id === "maine-coon" ? "50% 25%" : "50% 40%"}`}
            />
          </button>
        ) : (
          <div class="breed-placeholder">
            <Icon name="doodle" />
            <span>Portrait à venir</span>
          </div>
        )}
        <p class="hand">{b.name}, en personne.</p>
      </div>
      <div class="profile-info">
        <span class="badge" data-coat-type={b.coat}>
          {coatLabel(b)}
        </span>
        <h1>{b.name}</h1>
        <p>{b.intro}</p>
        <FavoriteButton breed={b} />
        <section class="identity">
          <h2>Carte d’identité</h2>
          <dl>
            <div>
              <dt>Race</dt>
              <dd>{b.name}</dd>
            </div>
            <div>
              <dt>Pelage</dt>
              <dd>{coatLabel(b)}</dd>
            </div>
            <div>
              <dt>Pays d’origine</dt>
              <dd>{b.country}</dd>
            </div>
            <div>
              <dt>Longévité indicative</dt>
              <dd>{b.lifeSpan} ans</dd>
            </div>
            {b.weight && (
              <div>
                <dt>Poids indicatif</dt>
                <dd>{b.weight} kg</dd>
              </div>
            )}
            {b.remark && (
              <div>
                <dt>À remarquer</dt>
                <dd>{b.remark}</dd>
              </div>
            )}
          </dl>
        </section>
      </div>
    </div>
    <div class="detail-notes">
      <section class="note">
        <h2>Son caractère</h2>
        <p>{b.temperament}</p>
        <small>Chaque chat garde sa propre personnalité.</small>
      </section>
      {b.fact && (
        <section class="note yellow">
          <h2 class="hand">Le petit truc à savoir</h2>
          <p>{b.fact}</p>
        </section>
      )}
    </div>
    <section class="section">
      <h2>{b.look ? "Ce qui le distingue" : "Pour en savoir plus"}</h2>
      {b.look && <p class="detail-body">{b.look}</p>}
      <a
        class="source-link"
        href={`${b.source}`}
        target="_blank"
        rel="noopener"
      >
        Présentation : {b.sourceLabel} ↗
      </a>
      {b.sourceLabel !== "TheCatAPI" && (
        <a class="source-link" href={b.api.url} target="_blank" rel="noopener">
          Pays, pelage, caractère, poids et longévité : {b.api.name} ↗
        </a>
      )}
    </section>
  </article>
  <section class="section">
    <div class="section-heading">
      <h2>À découvrir aussi</h2>
      <a class="text-link" href="/races/">
        Toutes les races <Icon />
      </a>
    </div>
    <BreedGrid breeds={breeds.filter((o) => o.id !== b.id).slice(0, 3)} />
  </section>
</Layout>
