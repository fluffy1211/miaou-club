---
import { photos } from "../lib/media";
interface Props {
  image: string;
  caption: string;
  classes?: string;
}
const { image, caption, classes = "" } = Astro.props;
const photo = photos[image];
---

<figure class:list={["polaroid", classes]}>
  <img
    src={photo.src}
    width={photo.width}
    height={photo.height}
    alt={caption}
  />
  <figcaption class="hand">{caption}</figcaption>
</figure>
