---
import FavoriteButton from "./FavoriteButton.astro";
import Icon from "./Icon.astro";
import { coatLabel, type Breed } from "../lib/breeds";
import { photos } from "../lib/media";
interface Props {
  breed: Breed;
  hidden?: boolean;
}
const { breed: b, hidden = false } = Astro.props;
const image = photos[b.image];
---

<article class="breed-card" data-breed={b.id} hidden={hidden}>
  <a
    class="card-image"
    href={`/race/${b.id}/`}
    tabindex="-1"
    aria-hidden="true"
  >
    {image ? (
      <img
        src={image.src}
        width={image.width}
        height={image.height}
        alt=""
        loading="lazy"
        decoding="async"
        style={`object-position:${b.id === "maine-coon" ? "50% 27%" : b.id === "siamese" ? "50% 14%" : b.id === "bengal" ? "50% 16%" : "50% 42%"}`}
      />
    ) : (
      <span class="breed-placeholder">
        <Icon name="doodle" />
        <span>Portrait à venir</span>
      </span>
    )}
  </a>
  <div class="card-body">
    <div class="card-title">
      <h3>
        <a href={`/race/${b.id}/`}>{b.name}</a>
      </h3>
      <FavoriteButton breed={b} compact />
    </div>
    <p class="card-description">{b.caption}</p>
    <span class="badge" data-coat-type={b.coat}>
      {coatLabel(b)}
    </span>
  </div>
</article>
