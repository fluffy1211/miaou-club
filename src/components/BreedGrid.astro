---
import BreedCard from "./BreedCard.astro";
import type { Breed } from "../lib/breeds";
interface Props {
  breeds: Breed[];
  id?: string;
  visibleCount?: number;
}
const { breeds, id, visibleCount } = Astro.props;
---

<div class="breed-grid" id={id}>
  {breeds.map((breed, index) => (
    <BreedCard
      breed={breed}
      hidden={visibleCount !== undefined && index >= visibleCount}
    />
  ))}
</div>
