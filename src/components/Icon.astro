---
interface Props {
  name?: "arrow" | "search" | "cat" | "doodle";
}
const { name = "arrow" } = Astro.props;
---

{name === "arrow" && (
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M6 18 18 6M6 6h12v12" />
  </svg>
)}
{name === "search" && (
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="10.5" cy="10.5" r="6.5" />
    <path d="m16 16 4 4" />
  </svg>
)}
{name === "cat" && (
  <svg viewBox="0 0 44 44" aria-hidden="true">
    <path d="M8 20 6 5l13 9h7L38 5l-2 17c5 15-27 22-28-2Z" />
    <path d="m14 25 4 1m10-1-4 1m-5 6q3 3 6 0" />
  </svg>
)}
{name === "doodle" && (
  <svg class="cat-doodle" viewBox="0 0 140 110" aria-hidden="true">
    <path d="M24 52 17 8l32 20q20-10 41 0l31-20-6 44q14 46-45 47-59-1-46-47Z" />
    <path
      fill="none"
      d="m39 55 10 2m42-2-10 2m-17 10h12l-6 6m0 0q-10 15-18 3m18-3q10 15 18 3M35 69 6 63m31 17L6 85m100-16 28-6m-30 17 30 5"
    />
  </svg>
)}
