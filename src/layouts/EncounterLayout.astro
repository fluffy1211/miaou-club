---
import AppHead from "./AppHead.astro";
import Icon from "../components/Icon.astro";
import { InstallPrompt } from "../components/InstallPrompt";
import "../styles/global.css";
import "../styles/encounters.css";
const { title = "Ton carnet" } = Astro.props;
Astro.response.headers.set("Cache-Control", "no-store");
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <AppHead title={`${title} — Miaou Club`} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Aller au contenu
    </a>
    <header class="encounter-header">
      <a class="logo" href="/" aria-label="Miaou Club, accueil">
        <Icon name="cat" />
        miaou club
      </a>
    </header>
    <main id="main" class="encounter-main">
      <slot />
    </main>
    <nav class="encounter-nav" aria-label="Navigation principale">
      <a
        href="/"
        aria-current={
          path === "/" || path === "/rencontres" ? "page" : undefined
        }
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m3 10 9-7 9 7v11h-6v-7H9v7H3Z" />
        </svg>
        Accueil
      </a>
      <a href="/carte" aria-current={path === "/carte" ? "page" : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m2 5 6-3 8 3 6-3v17l-6 3-8-3-6 3ZM8 2v17M16 5v17" />
        </svg>
        Carte
      </a>
      <a href="/photo" aria-current={path === "/photo" ? "page" : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 7h5l2-3h4l2 3h5v13H3Z" />
          <circle cx="12" cy="13" r="4" />
        </svg>
        Photo
      </a>
      <a
        href="/carnet"
        aria-current={
          path === "/carnet" || path.startsWith("/rencontre/")
            ? "page"
            : undefined
        }
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 3h14v18H6ZM3 7h6M3 12h6M3 17h6M12 8h4M12 13h4" />
        </svg>
        Carnet
      </a>
      <a
        href="/profil"
        aria-current={
          path.startsWith("/profil") ||
          ["/amis", "/donnees", "/administration"].includes(path)
            ? "page"
            : undefined
        }
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="8" r="4" />
          <path d="M4 22v-2a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v2" />
        </svg>
        Profil
      </a>
    </nav>
    <InstallPrompt client:idle />
  </body>
</html>
