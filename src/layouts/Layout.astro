---
import Icon from "../components/Icon.astro";
import { getBreeds } from "../lib/breeds";
import { photos } from "../lib/media";
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = "Miaou Club",
  description = "Un carnet pour découvrir les races de chats et collectionner tes coups de cœur.",
  noindex = false,
} = Astro.props;
const pathname = Astro.url.pathname;
const entries = (await getBreeds()).map(
  ({ id, name, aliases, coat, image }) => ({
    id,
    name,
    aliases,
    coat,
    image: photos[image]?.src,
  }),
);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FFF8ED" />
    <title>{title === 'Miaou Club' ? title : `${title} — Miaou Club`}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Aller au contenu
    </a>
    <header class="site-header container">
      <a class="logo" href="/" aria-label="Miaou Club, accueil">
        <Icon name="cat" />
        miaou club
      </a>
      <button
        class="menu-toggle icon-button"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="navigation"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
      <nav id="navigation" aria-label="Navigation principale">
        <a href="/photo">Photo</a>
        <a href="/carnet">Mon carnet</a>
        <a
          href="/races/"
          aria-current={pathname.startsWith("/race") ? "page" : undefined}
        >
          Les races
        </a>
        <a
          href="/a-propos/"
          aria-current={pathname === "/a-propos/" ? "page" : undefined}
        >
          Le club
        </a>
        <a
          class="nav-favorites"
          href="/favoris/"
          aria-current={pathname === "/favoris/" ? "page" : undefined}
        >
          Mes favoris
        </a>
      </nav>
    </header>
    <main id="main" tabindex="-1" class="container">
      <slot />
    </main>
    <footer class="site-footer container">
      <a class="logo" href="/">
        miaou club
      </a>
      <a href="/a-propos/">À propos & sources</a>
    </footer>
    <div class="toast" role="status" aria-live="polite"></div>
    <dialog id="photo-dialog" aria-label="Photo agrandie">
      <button
        class="dialog-close icon-button"
        aria-label="Fermer la photo"
        autofocus
      >
        ×
      </button>
      <img alt="" />
      <p></p>
    </dialog>
    <script
      id="breed-index"
      data-figue-photo={photos["figue-cover.jpg"].src}
      type="application/json"
      set:html={JSON.stringify(entries).replace(/</g, "\\u003c")}
    />
    <script>
      import "../scripts/app";
    </script>
  </body>
</html>
