{
  "strictness": 2,
  "commentTypes": ["logic", "syntax"],
  "effort": "base",
  "includeBranches": ["develop", "main"],
  "autoReview": ["open"],
  "statusCheck": true,
  "shouldUpdateDescription": false,
  "autoApprove": {
    "enabled": false
  },
  "ignorePatterns": "node_modules/**\ndist/**\n.cache/**\nstorybook-static/**\ndocs/archives/**",
  "instructions": "Répondre en français. Vérifier les défauts concrets du diff dans le contexte du dépôt. Aucune correction ni approbation automatique."
}
