# Fichier de contrôle local uniquement. Remplir avec les valeurs du fournisseur
# approuvé avant un contrôle ; ce modèle incomplet doit échouer.
NODE_ENV=production
HOST=0.0.0.0
PORT=4321
BETTER_AUTH_URL=https://<origine-a-completer>
BETTER_AUTH_SECRET=
DATABASE_URL=postgresql://<utilisateur>:<mot-de-passe>@<hote>/<base>?sslmode=verify-full
MIAOU_STORAGE_URL=https://<origine-a-completer>
MIAOU_STORAGE_SECRET=
MIAOU_STORAGE_BUCKET=
MIAOU_LOCAL_MEDIA_DIR=
MIAOU_TERMS_VERSION=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
MIAOU_MAIL_FROM=
PUBLIC_MIAOU_MAPTILER_APPROVED=0
PUBLIC_MIAOU_MAPTILER_KEY=
