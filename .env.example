# Clé privée utilisée uniquement pendant la récupération des données au build.
# Ne pas préfixer par PUBLIC_ et ne pas versionner le fichier .env.
CAT_API_KEY=

# Local development only. Generate a private value with: openssl rand -base64 32
DATABASE_URL=postgresql://miaou:local-development-only@127.0.0.1:54329/miaou_dev
BETTER_AUTH_URL=http://localhost:4321
BETTER_AUTH_SECRET=
# Optional, existing authorized test credentials only. No real Google test yet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server tests refuse non-test databases.
TEST_DATABASE_URL=postgresql://miaou_test:local-test-only@127.0.0.1:54330/miaou_test

# Leave unset until the CGU have been finalized; no registration without a version.
MIAOU_TERMS_VERSION=
RESEND_API_KEY=
MIAOU_MAIL_FROM=

# Hosting-only operator identifier for audited account operations.
MIAOU_OPERATOR=

# Private photo bucket only. Server key; never PUBLIC_ or browser configuration.
# Supabase is storage only; existing PostgreSQL/Better Auth remain authoritative.
MIAOU_STORAGE_URL=
MIAOU_STORAGE_SECRET=
MIAOU_STORAGE_BUCKET=
# Development/test only, private path outside static directories. Unset in production.
MIAOU_LOCAL_MEDIA_DIR=

# Map provider closed until contractual review and explicit activation authorization.
# Public browser key: restrict to the approved domains in MapTiler, never reuse a server key.
# Build-time configuration. Empty means local contours only, without provider requests.
PUBLIC_MIAOU_MAPTILER_APPROVED=0
PUBLIC_MIAOU_MAPTILER_KEY=
